{
  "name": "sweaxbeacon",
  "productName": "SweaxBeacon",
  "version": "2.0.0",
  "description": "SweaxBeacon: Minecraft Java powers, items and world controls for your server, your LAN world and single-player, with no login.",
  "author": "Sweax Studios",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:helper": "node tools/build-helper.cjs",
    "build:renderer": "vite build",
    "build:demo": "vite build --mode demo",
    "icons": "python tools/pixel_icons.py",
    "start": "electron .",
    "test:server": "node tools/test/server-test.cjs",
    "test:chat": "node tools/test/chat-link-test.cjs",
    "dist": "node tools/build-helper.cjs && vite build && electron-builder --win nsis",
    "build:site-app": "vite build --outDir docs/app --emptyOutDir"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "vite": "^6.0.7",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.sweaxstudios.sweaxbeacon",
    "productName": "SweaxBeacon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SweaxBeacon-Kurulum-${version}.exe",
      "shortcutName": "SweaxBeacon"
    },
    "extraResources": [
      {
        "from": "native/bin/sweax-helper.exe",
        "to": "native/sweax-helper.exe"
      }
    ]
  }
}
