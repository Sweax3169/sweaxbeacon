{
  "name": "sweaxpanel",
  "productName": "SweaxPanel",
  "version": "1.0.0",
  "description": "Sweax Studios — Minecraft sunucu komuta merkezi (RCON masaüstü paneli)",
  "author": "Sweax Studios",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.3",
    "vite": "^6.0.7",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.sweaxstudios.sweaxpanel",
    "productName": "SweaxPanel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SweaxPanel-Kurulum-${version}.exe",
      "shortcutName": "SweaxPanel"
    }
  }
}
