.env
.env.*
sweaxpanel-settings.json
.claude/
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# large binaries never belong in git (installers go to GitHub Releases)
*.exe
*.blockmap
*.msi
*.zip
*.7z
*.asar
*.mp4.tmp
